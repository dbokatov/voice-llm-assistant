# Master switch for every route that can consume paid provider tokens.
# Production is disabled unless this is explicitly true.
DEMO_ENABLED=true

# Copy this file to .env and replace only the key you want to test.
OPENAI_API_KEY=replace-with-openai-api-key
GEMINI_API_KEY=replace-with-gemini-api-key

OPENAI_MODEL=gpt-5-nano
GEMINI_MODEL=gemini-3.5-flash-lite

# Used by both the ASR and TTS token routes. Keep this key server-side.
ELEVENLABS_API_KEY=replace-with-elevenlabs-api-key
ELEVENLABS_VOICE_ID=OYTbf65OHHFELVut7v2H
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# AWS production only: SAM supplies the Secrets Manager ARN to Lambda. Leave
# this unset locally so the server reads the provider keys above from .env.
# PROVIDER_SECRET_ARN=arn:aws:secretsmanager:region:account:secret:name
